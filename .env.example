# ---------------------------------------------------------------------------
# DeutschPath environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or real keys to git.
# ---------------------------------------------------------------------------

# --- Supabase: public (safe to expose to the browser) ----------------------
# Project URL and the public anon/publishable key from:
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: server-only (NEVER expose to the browser) -------------------
# Service role key — used only by trusted server code / admin content tooling.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ------------------------------------------------------------------
# Public base URL of the site. Used for auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 (non-production only) to let the modules serve imported content that
# is still `needs_review`, so you can test before German review/publishing.
# Leave unset in production — only `published` content is served there.
CONTENT_PREVIEW=

# ---------------------------------------------------------------------------
# The variables below are NOT used in Milestone 1.
# They are listed here so the contract is clear and keys are kept server-side
# from the start. Leave them blank for now.
# ---------------------------------------------------------------------------

# --- AI evaluation (Milestone 3+, server-only) -----------------------------
OPENAI_API_KEY=
# Default model is configurable; keep identifiers in server config, not code.
OPENAI_EVAL_MODEL=

# --- Text-to-speech for Dictation (Milestone 4+, server-only) --------------
# TTS_PROVIDER selects the adapter: "mock" for local dev, "telnyx" in prod.
TTS_PROVIDER=mock
TELNYX_API_KEY=
